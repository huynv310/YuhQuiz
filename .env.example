# Dán thông tin dự án Supabase của bạn tại đây
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Chỉ bật khi deploy Vercel kèm /api/auth/* (token refresh nằm trong cookie httpOnly)
VITE_USE_BFF=false
# Chỉ đặt trên Vercel (server-side), KHÔNG có tiền tố VITE_
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Secret nội bộ để auth_rl_fail/auth_rl_reset chỉ chấp nhận gọi từ BFF (không dùng service_role).
# Tạo 1 chuỗi ngẫu nhiên (vd: openssl rand -hex 32), đặt cùng giá trị bằng (SQL Editor):
#   INSERT INTO public._rl_secret (id, secret) VALUES (true, '<secret>')
#   ON CONFLICT (id) DO UPDATE SET secret = EXCLUDED.secret;
RL_INTERNAL_SECRET=
